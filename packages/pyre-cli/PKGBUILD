# Maintainer: PyreOS contributors
# The pyre lifecycle tool, reconcile units and hardware rules (ADR 0007,
# ADR 0014), and the agent skill (ADR 0019). The sources are in src/cli/,
# src/hw/, skills/ and system/ of this repository, so the package is built in
# place.
pkgname=pyre-cli
pkgver=0.5.0
pkgrel=1
pkgdesc='PyreOS lifecycle tool: update, snapshot, rollback, doctor, reconcile, themes, menu, keys, welcome, reminders, hardware rules, agent skill'
arch=(any)
url='https://github.com/bayrock/pyre-os'
license=(MIT)
depends=(bash coreutils diffutils snapper sudo util-linux)
optdepends=('libnotify: notifications about .pyre-new files, and reminders'
            'fzf: the package search of pyre menu'
            'foot: the terminal pyre menu runs installs and updates in')

package() {
  local root="$startdir/../.." dir
  install -Dm755 "$root/src/cli/pyre" "$pkgdir/usr/bin/pyre"
  for dir in lib commands reconcile/system reconcile/user; do
    install -d "$pkgdir/usr/lib/pyre/$dir"
    find "$root/src/cli/$dir" -maxdepth 1 -type f -exec install -m644 -t "$pkgdir/usr/lib/pyre/$dir" {} +
  done
  (cd "$root/src/hw" && find rules files -type f -exec install -Dm644 {} "$pkgdir/usr/share/pyre/hw/{}" \;)
  # The PyreOS menu's rows and its catalog of optional apps (ADR 0021): data.
  install -Dm644 -t "$pkgdir/usr/share/pyre/menu" "$root"/src/cli/menu/*.tsv
  # The agent skills, which the user unit 004-agent-skills links into each
  # home for the coding agents that read them (ADR 0019).
  (cd "$root/skills" && find -- * -type f -exec install -Dm644 {} "$pkgdir/usr/share/pyre/skills/{}" \;)
  install -Dm644 "$root/system/alpm/pyre-reconcile.hook" "$pkgdir/usr/share/libalpm/hooks/pyre-reconcile.hook"
  install -Dm644 "$root/system/systemd-user/pyre-reconcile.service" \
    "$pkgdir/usr/lib/systemd/user/pyre-reconcile.service"
  install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../pyre-reconcile.service "$pkgdir/usr/lib/systemd/user/default.target.wants/pyre-reconcile.service"
  # pyre remind's timers are set again whenever the desktop starts (ADR 0020).
  install -Dm644 "$root/system/systemd-user/pyre-remind.service" \
    "$pkgdir/usr/lib/systemd/user/pyre-remind.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../pyre-remind.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/pyre-remind.service"
}
