# Maintainer: PyreOS contributors
# pyre.gpg holds the release key (release.asc) and the development key; tools/dev-key
# assembles it. Release images drop the development key in P7 (ADR 0009).
pkgname=pyre-keyring
pkgver=0.2.0
pkgrel=1
pkgdesc='PyreOS PGP keyring (release and development keys)'
arch=(any)
url='https://github.com/bayrock/pyre-os'
license=(MIT)
depends=(pacman)
install=pyre-keyring.install
source=(pyre.gpg pyre-trusted pyre-revoked)
sha256sums=('31bd008804c9d30ab1f960f421c415e40b0e8b2b4b6382dc4bef40023cb440f3'
            '28b49fc98d9bb2e2f4d5734df0987b9857d57795e89a69f12c68b9b55e80878a'
            'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855')

package() {
  local file
  for file in pyre.gpg pyre-trusted pyre-revoked; do
    install -Dm644 "$file" "$pkgdir/usr/share/pacman/keyrings/$file"
  done
}
