# Maintainer: PyreOS contributors
# The key in pyre.gpg is the DEVELOPMENT key from tools/dev-key, never a release key (ADR 0009).
pkgname=pyre-keyring
pkgver=0.1.0
pkgrel=1
pkgdesc='PyreOS PGP keyring (development key)'
arch=(any)
url='https://github.com/bayrock/pyre-os'
license=(MIT)
depends=(pacman)
install=pyre-keyring.install
source=(pyre.gpg pyre-trusted pyre-revoked)
sha256sums=('a487720f3f562efadc28fe341fe483571a2f6ee81f09aa4ea8177c7d69f68c01'
            '8d85921095de7c3056bb33e7738c989f57f33d49f3ba21ca05af8dd9aff9feb1'
            'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855')

package() {
  local file
  for file in pyre.gpg pyre-trusted pyre-revoked; do
    install -Dm644 "$file" "$pkgdir/usr/share/pacman/keyrings/$file"
  done
}
