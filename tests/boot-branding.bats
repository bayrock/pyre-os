#!/usr/bin/env bats
# pyre-base's boot-branding: the PyreOS block in limine.conf (ADR 0015).

setup() {
  repo="$BATS_TEST_DIRNAME/.."
  export PYRE_ROOT="$BATS_TEST_TMPDIR/root"
  share="$PYRE_ROOT/usr/share/pyre/boot"
  mkdir -p "$share" "$PYRE_ROOT/etc/default" "$PYRE_ROOT/boot"
  cp "$repo/packages/pyre-base/limine-branding.conf" "$repo/packages/pyre-base/limine-wallpaper.jpg" "$share/"
  printf 'ESP_PATH="/boot"\nKERNEL_CMDLINE[default]+="rw"\n' >"$PYRE_ROOT/etc/default/limine"
  conf="$PYRE_ROOT/boot/limine.conf"
  printf '### Auto-generated by limine-entry-tool\n/+PyreOS\ncomment: machine-id=x\n  //linux\n  protocol: linux\n' >"$conf"
  entries="$(cat "$conf")"
}

brand() {
  "$repo/packages/pyre-base/pyre-boot-branding"
}

@test "adds the block at the top, copies the wallpaper, keeps every entry, and is idempotent" {
  run brand
  [ "$status" -eq 0 ]
  [ "$(head -n 1 "$conf")" = "# >>> PyreOS boot menu" ]
  grep -qx 'interface_branding: PyreOS' "$conf"
  [ "$(sed -n '/^# <<< PyreOS boot menu$/,$p' "$conf" | sed 1d)" = "$entries" ]
  cmp "$share/limine-wallpaper.jpg" "$PYRE_ROOT/boot/pyre/wallpaper.jpg"
  first="$(cat "$conf")"
  run brand
  [ "$status" -eq 0 ]
  [ "$output" = "" ]
  [ "$(cat "$conf")" = "$first" ]
}

@test "replaces an older block instead of adding a second one" {
  printf '# >>> PyreOS boot menu\ninterface_branding: Old\n# <<< PyreOS boot menu\n' | cat - "$conf" >"$conf.new" && mv "$conf.new" "$conf"
  brand
  [ "$(grep -c '^# >>> PyreOS boot menu$' "$conf")" -eq 1 ]
  ! grep -q 'interface_branding: Old' "$conf"
}

@test "an opt-out line leaves limine.conf alone, and a missing limine.conf is not an error" {
  printf '# pyre-boot-branding: off\n' >>"$conf"
  before="$(cat "$conf")"
  brand
  [ "$(cat "$conf")" = "$before" ]
  rm "$conf"
  run brand
  [ "$status" -eq 0 ]
  [[ "$output" == *"no "*"limine.conf yet"* ]]
}

@test "the ESP path comes from /etc/default/limine" {
  sed -i 's|^ESP_PATH=.*|ESP_PATH="/efi"|' "$PYRE_ROOT/etc/default/limine"
  mkdir -p "$PYRE_ROOT/efi"
  mv "$conf" "$PYRE_ROOT/efi/limine.conf"
  brand
  grep -qx 'interface_branding: PyreOS' "$PYRE_ROOT/efi/limine.conf"
  [ -f "$PYRE_ROOT/efi/pyre/wallpaper.jpg" ]
}
