# shellcheck shell=bash
# help: remind me: a notification at a time you name
# usage: pyre remind <when> [message]   |   pyre remind list   |   pyre remind cancel <number>|all
#   <when>   10m, 90s, 1h30m, 2 hours    that long from now
#            17:30, 5pm, noon            the next time the clock shows it
#            tomorrow, fri 9am           that day, at 09:00 unless a time follows
#   The time may come last instead: pyre remind call mum at 5pm
#   list     the pending reminders, soonest first
#   cancel   drop one reminder by its number, or all of them
# In the launcher: "/remind 10m tea", or plain "remind me to call mum at 5pm".
#
# A reminder is a file, ~/.local/state/pyre/reminders/<number>, holding its
# time and its message, and a transient systemd user timer that runs
# "pyre remind --fire <number>". The timer is on the wall clock, so it is
# right after a suspend. Timers end with the session: pyre-remind.service
# runs "pyre remind --rearm" at login, which sets them again and shows what
# came due meanwhile. --parse prints what a text would set, for the launcher.

remind_dir() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/pyre/reminders"
}

# The time, in seconds since the epoch. Tests set PYRE_REMIND_NOW.
remind_now() {
  printf '%s\n' "${PYRE_REMIND_NOW:-$(date +%s)}"
}

# remind_duration WORD...: the seconds in "10m", "1h30m", "2 hours" or "1.5h".
remind_duration() {
  local rest="$*" total=0 unit
  rest="${rest// /}"
  while [[ -n "$rest" ]]; do
    [[ "$rest" =~ ^([0-9]{1,5})(\.([0-9]))?([a-z]+)(.*)$ ]] || return 1
    case "${BASH_REMATCH[4]}" in
      s | sec | secs | second | seconds) unit=1 ;;
      m | min | mins | minute | minutes) unit=60 ;;
      h | hr | hrs | hour | hours) unit=3600 ;;
      d | day | days) unit=86400 ;;
      w | wk | week | weeks) unit=604800 ;;
      *) return 1 ;;
    esac
    total=$((total + (10#${BASH_REMATCH[1]} * 10 + ${BASH_REMATCH[3]:-0}) * unit / 10))
    rest="${BASH_REMATCH[5]}"
  done
  # At most a year ahead.
  (( total > 0 && total <= 31622400 )) && printf '%s\n' "$total"
}

# remind_clock WORD: "5pm", "5:30pm", "17:30", "noon" or "midnight" as HH:MM.
remind_clock() {
  local hour minute
  case "$1" in
    noon) echo 12:00; return 0 ;;
    midnight) echo 00:00; return 0 ;;
  esac
  [[ "$1" =~ ^([0-9]{1,2})(:([0-9]{2}))?(am|pm)?$ && -n "${BASH_REMATCH[2]}${BASH_REMATCH[4]}" ]] || return 1
  hour=$((10#${BASH_REMATCH[1]}))
  minute=$((10#${BASH_REMATCH[3]:-0}))
  if [[ -n "${BASH_REMATCH[4]}" ]]; then
    (( hour >= 1 && hour <= 12 )) || return 1
    hour=$((hour % 12))
    [[ "${BASH_REMATCH[4]}" == pm ]] && hour=$((hour + 12))
  fi
  (( hour <= 23 && minute <= 59 )) || return 1
  printf '%02d:%02d\n' "$hour" "$minute"
}

# remind_epoch NOW WORD...: when the lowercase WORDs name one time, print it
# in seconds since the epoch: a duration from NOW, a clock time, a day, or a
# day and a clock time.
remind_epoch() {
  local now="$1" day="" clock="" word noon at i
  shift
  [[ "${1:-}" == @(in|at|on) ]] && shift
  (( $# )) || return 1
  # "an hour", "a minute"
  [[ "$1" == @(a|an) ]] && set -- 1 "${@:2}"
  if at="$(remind_duration "$@")"; then
    printf '%s\n' "$((now + at))"
    return 0
  fi
  for word in "$@"; do
    case "$word" in
      at) ;;
      am | pm)
        [[ "$clock" == *[0-9] ]] || return 1
        clock="$(remind_clock "$clock$word")" || return 1
        ;;
      today | tomorrow | mon | monday | tue | tues | tuesday | wed | wednesday | thu | thur | thurs | thursday | fri | friday | sat | saturday | sun | sunday)
        [[ -z "$day" ]] || return 1
        day="${word:0:3}"
        ;;
      *)
        [[ -z "$clock" ]] || return 1
        # A bare "5" waits for its "pm".
        [[ "$word" =~ ^[0-9]{1,2}$ ]] && clock="$word" && continue
        clock="$(remind_clock "$word")" || return 1
        ;;
    esac
  done
  [[ -n "$day$clock" && "${clock:-:}" == *:* ]] || return 1
  # Days are counted from noon, which exists on every date.
  noon="$(date -d "$(date -d "@$now" +%F) 12:00" +%s)" || return 1
  for i in 0 1 2 3 4 5 6 7; do
    word="$(LC_ALL=C date -d "@$((noon + i * 86400))" '+%F %a')"
    case "$day" in
      "") ;;
      tod) (( i == 0 )) || return 1 ;;
      tom) (( i == 1 )) || continue ;;
      *) [[ "${word#* }" == "${day^}" ]] || continue ;;
    esac
    # A time the clock skips (a change to summer time) is no time.
    at="$(date -d "${word% *} ${clock:-09:00}" +%s 2>/dev/null)" || return 1
    (( at > now )) && { printf '%s\n' "$at"; return 0; }
  done
  return 1
}

# remind_parse NOW TEXT...: split TEXT into a time and a message, as
# REMIND_AT and REMIND_MSG. The time is the longest run of words that names
# one, at the start ("10m tea") or else at the end ("call mum at 5pm").
remind_parse() {
  local now="$1" count k
  local -a words lower
  shift
  read -ra words <<<"${*//$'\n'/ }" || true
  [[ "${words[0]:-}" == [Mm]e ]] && words=("${words[@]:1}")
  lower=("${words[@],,}")
  count=${#words[@]}
  for ((k = count < 6 ? count : 6; k >= 1; k--)); do
    REMIND_AT="$(remind_epoch "$now" "${lower[@]:0:k}")" || continue
    words=("${words[@]:k}")
    break
  done
  for ((k = count < 6 ? count : 6; k >= 1 && ${#words[@]} == count; k--)); do
    REMIND_AT="$(remind_epoch "$now" "${lower[@]:count-k}")" || continue
    words=("${words[@]:0:count-k}")
  done
  (( ${#words[@]} < count )) || return 1
  [[ "${words[0]:-}" == [Tt]o ]] && words=("${words[@]:1}")
  REMIND_MSG="${words[*]}"
  REMIND_MSG="${REMIND_MSG:0:200}"
}

# remind_when NOW AT: "17:00 (in 2 h 5 min)", with the day when it is not today.
remind_when() {
  local now="$1" at="$2" left=$(($2 - $1)) day stamp span
  day="$(date -d "@$at" +%F)"
  if [[ "$day" == "$(date -d "@$now" +%F)" ]]; then
    stamp="$(date -d "@$at" +%H:%M)"
  elif [[ "$day" == "$(date -d "@$((now + 86400))" +%F)" ]]; then
    stamp="tomorrow $(date -d "@$at" +%H:%M)"
  else
    stamp="$(date -d "@$at" '+%a %-d %b %H:%M')"
  fi
  if (( left <= 0 )); then
    span=due
  elif (( left < 60 )); then
    span="in $left s"
  elif (( left < 3600 )); then
    span="in $(((left + 30) / 60)) min"
  elif (( left < 86400 )); then
    span="in $((left / 3600)) h $((left % 3600 / 60)) min"
  else
    span="in $((left / 86400)) d $((left % 86400 / 3600)) h"
  fi
  # "in 3 h", not "in 3 h 0 min"
  span="${span% 0 *}"
  printf '%s (%s)\n' "$stamp" "$span"
}

# remind_files: the reminder files, one per line.
remind_files() {
  local file
  for file in "$(remind_dir)"/*; do
    [[ "${file##*/}" =~ ^[0-9]+$ && -f "$file" ]] && printf '%s\n' "$file"
  done
  return 0
}

# remind_schedule ID AT: a transient timer that fires reminder ID at AT. A
# calendar time in the past never elapses, so a time already here is moved a
# moment ahead.
remind_schedule() {
  local at="$2" soon
  soon=$(($(date +%s) + 2))
  (( at > soon )) || at=$soon
  systemd-run --user --quiet --collect --unit="pyre-remind-$1" --description="PyreOS reminder $1" \
    --on-calendar="$(date -u -d "@$at" '+%Y-%m-%d %H:%M:%S UTC')" \
    --timer-property=AccuracySec=1s --timer-property=RemainAfterElapse=no \
    ${XDG_STATE_HOME:+--setenv=XDG_STATE_HOME="$XDG_STATE_HOME"} \
    "$PYRE_BIN" remind --fire "$1" >/dev/null
}

remind_add() {
  local now dir file id=0
  now="$(remind_now)"
  remind_parse "$now" "$@" ||
    die "remind: when? Try \"10m tea\", \"5pm call mum\" or \"tomorrow 9am standup\" (pyre help remind)"
  dir="$(remind_dir)"
  while IFS= read -r file; do
    (( 10#${file##*/} > id )) && id=$((10#${file##*/}))
  done < <(remind_files)
  id=$((id + 1))
  printf '%s\n%s\n' "$REMIND_AT" "$REMIND_MSG" | write_atomic "$dir/$id"
  if ! remind_schedule "$id" "$REMIND_AT"; then
    rm -f -- "$dir/$id"
    die "remind: could not set a timer; is the systemd user session running?"
  fi
  info "reminder $id set for $(remind_when "$now" "$REMIND_AT")${REMIND_MSG:+: $REMIND_MSG}"
}

# Tab-separated number, time and message; in columns on a terminal.
remind_list() {
  local now file id at msg
  now="$(remind_now)"
  while IFS= read -r file; do
    { read -r at || true; read -r msg || true; } <"$file"
    if [[ "$at" =~ ^[0-9]+$ ]]; then printf '%s\t%s\t%s\n' "$at" "${file##*/}" "$msg"; fi
  done < <(remind_files) | sort -n | while IFS=$'\t' read -r at id msg; do
    printf '%s\t%s\t%s\n' "$id" "$(remind_when "$now" "$at")" "${msg:-Reminder}"
  done | if [[ -t 1 ]]; then column -t -s $'\t'; else cat; fi
}

remind_cancel() {
  local file id count=0
  [[ "${1:-}" =~ ^([0-9]+|all)$ ]] || die "remind cancel takes a reminder's number, or all (pyre remind list)"
  while IFS= read -r file; do
    id="${file##*/}"
    [[ "$1" == all || "$1" == "$id" ]] || continue
    rm -f -- "$file"
    systemctl --user --quiet stop "pyre-remind-$id.timer" 2>/dev/null || true
    count=$((count + 1))
  done < <(remind_files)
  (( count )) || die "remind: no reminder $1 (pyre remind list)"
  info "cancelled $count reminder(s)"
}

# remind_fire ID: show reminder ID and forget it. The notification stays up
# until it is dismissed. Without a notification service (the shell is still
# starting, or this is not a desktop session) the reminder is kept.
remind_fire() {
  local file at msg="" now body deadline
  [[ "${1:-}" =~ ^[0-9]+$ ]] || die "remind --fire takes a reminder's number"
  file="$(remind_dir)/$1"
  [[ -f "$file" ]] || return 0
  { read -r at || true; read -r msg || true; } <"$file"
  [[ "$at" =~ ^[0-9]+$ ]] || die "remind: reminder $1 is damaged: $file"
  now="$(remind_now)"
  body="$(remind_when "$now" "$at")"
  body="Reminder for ${body% (*}"
  (( now - at > 120 )) && body+=", which passed while you were away"
  deadline=$((SECONDS + ${PYRE_REMIND_WAIT:-60}))
  until notify-send -a Reminder -i alarm-symbolic -t 0 -- "${msg:-Reminder}" "$body" 2>/dev/null; do
    (( SECONDS < deadline )) || die "remind: no notification service; reminder $1 is kept for the next login"
    sleep 5
  done
  rm -f -- "$file"
}

# remind_rearm: at login, set the timer of every reminder that has none. One
# that came due while the session was away fires right away.
remind_rearm() {
  local file id at
  while IFS= read -r file; do
    id="${file##*/}"
    [[ -z "$(systemctl --user list-units --all --plain --no-legend "pyre-remind-$id.*" 2>/dev/null)" ]] || continue
    read -r at <"$file" || true
    if ! { [[ "$at" =~ ^[0-9]+$ ]] && remind_schedule "$id" "$at"; }; then
      warn "could not set the timer of reminder $id"
    fi
  done < <(remind_files)
}

cmd_remind() {
  local now
  local -a args
  read -ra args <<<"${*//$'\n'/ }" || true
  set -- "${args[@]}"
  case "${1:-}" in
    -h | --help) command_usage "${BASH_SOURCE[0]}" ;;
    --parse)
      shift
      now="$(remind_now)"
      remind_parse "$now" "$@" || die "remind: no time in \"$*\""
      printf '%s\t%s\t%s\n' "$REMIND_AT" "$(remind_when "$now" "$REMIND_AT")" "$REMIND_MSG"
      ;;
    --fire) remind_fire "${2:-}" ;;
    --rearm) remind_rearm ;;
    -*) die "remind: unknown option $1 (pyre help remind)" ;;
    *)
      if (( $# == 0 )) || [[ $# -eq 1 && "$1" == list ]]; then
        remind_list
      elif [[ "$1" == cancel && $# -le 2 ]]; then
        remind_cancel "${2:-}"
      else
        remind_add "$@"
      fi
      ;;
  esac
}
