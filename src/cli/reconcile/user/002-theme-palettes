# shellcheck shell=bash disable=SC2034 # since is read by the engine
# about: link the PyreOS theme palettes into Noctalia's palette folder (ADR 0015)
# Noctalia reads custom palettes only from ~/.config/noctalia/palettes/, and
# the default config selects Ember from there. Each theme gets a link named
# after it, which follows package updates. A file of your own under the same
# name is left alone.
since=2

themes="$PYRE_ROOT/usr/share/pyre/themes"
palettes="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/palettes"

# pending: "palette link" pairs still to make, one per line.
pending() {
  local dir name link
  for dir in "$themes"/*/; do
    [[ -f "$dir/theme.toml" && -f "$dir/palette.json" ]] || continue
    name="$(sed -n 's/^name *= *"\(.*\)"$/\1/p' "$dir/theme.toml" | head -n 1)"
    [[ -n "$name" ]] || continue
    link="$palettes/$name.json"
    [[ -e "$link" && ! -L "$link" ]] && continue
    [[ -L "$link" && "$(readlink -- "$link")" == "${dir%/}/palette.json" ]] && continue
    printf '%s\t%s\n' "${dir%/}/palette.json" "$link"
  done
  return 0
}

check() {
  [[ -z "$(pending)" ]]
}

apply() {
  local palette link
  while IFS=$'\t' read -r palette link; do
    mkdir -p -- "$palettes"
    ln -sfn -- "$palette" "$link"
  done < <(pending)
}
