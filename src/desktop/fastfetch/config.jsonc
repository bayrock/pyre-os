// PyreOS's fastfetch defaults: the flame mark instead of the Arch logo.
// Package-owned (pyre-desktop). Your own ~/.config/fastfetch/config.jsonc
// wins over this file; copy it there to change anything.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/pyre/fastfetch/pyre.txt",
    // The mark's gradient, top to bottom: orange, gold, then down to coral.
    "color": {
      "1": "38;2;217;128;60",
      "2": "38;2;233;183;81",
      "3": "38;2;233;162;81",
      "4": "38;2;233;143;81",
      "5": "38;2;233;123;81",
      "6": "38;2;233;109;81"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    // The labels follow the theme: the terminal's yellow is each theme's gold.
    "color": { "keys": "yellow", "title": "yellow" }
  },
  // fastfetch's own default list: a config without one shows no modules.
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal", "terminalfont", "cpu", "gpu", "memory", "swap", "disk",
    "localip", "battery", "poweradapter", "locale", "break", "colors"
  ]
}
