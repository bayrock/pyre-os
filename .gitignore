# archiso generated output and work directories
/out/
/work/
/build/
*.iso
*.iso.sig

# Package/build artifacts
*.pkg.tar.*
*.src.tar.*
/packages/*/pkg/
/packages/*/src/

# Local machine/build configuration and credentials
.env
.env.*
!.env.example
*.gpg
*.asc
*.key
# Public keyring: release.asc is the release public key, and tools/dev-key assembles
# pyre.gpg from it and the development key. Private keys stay offline or in build/keys/.
!packages/pyre-keyring/pyre.gpg
!packages/pyre-keyring/release.asc

# Editor and OS noise
.DS_Store
*~
*.swp
*.swo

# Python bytecode from dev tools
__pycache__/

# Claude Code session worktrees (local only)
/.claude/worktrees/
