#!/usr/bin/env bash
# shellcheck disable=SC2016 # probes are typed into the guest verbatim
# The P4 exit scenario (ROADMAP, ADR 0009 release gate), headless under UEFI:
# an N-1 -> N upgrade, then a deliberately broken update rolled back to a
# working desktop.
# Usage: tools/test-upgrade [--from STAGE] [ISO]   (default: newest build/out/pyreos-*.iso)
# Stages: install, upgrade, desktop, break, recover, rolled-back.
#   install      offline install from ISO (release N-1), [pyre] pointing at this host
#   upgrade      pyre update to release N: every PyreOS package rebuilt with
#                pkgrel+1 and a canary reconcile unit per scope
#   desktop      reboot into N: greeter, session, user reconcile
#   break        pyre update to N+1, whose greeter cannot start; reboot shows it broken
#   recover      boot the pre-update snapshot from Limine, check it, pyre rollback
#   rolled-back  a normal boot reaches a working desktop again, at release N
# The releases are built under build/upgrade/ and served on 127.0.0.1:8080.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
tool=test-upgrade
name=test-upgrade
# shellcheck source=tools/lib/vmtest.sh
source "$repo_root/tools/lib/vmtest.sh"
work="$repo_root/build/upgrade"
served="$work/repo"
pyre_repo=http://10.0.2.2:8080/upgrade/repo
server_pid=""

from=install
case "${1:-}" in
  -h | --help) sed -n '3,14s/^# //p' "${BASH_SOURCE[0]}"; exit 0 ;;
  --from) from="${2:?--from needs a stage}"; shift 2 ;;
esac
stages=(install upgrade desktop break recover rolled-back)
[[ " ${stages[*]} " == *" $from "* ]] || { echo "$tool: unknown stage: $from" >&2; exit 2; }
iso="${1:-}"
if [[ -z "$iso" ]]; then
  iso="$(find "$repo_root/build/out" -maxdepth 1 -name 'pyreos-*.iso' -printf '%T@ %p\n' 2>/dev/null |
    sort -n | tail -n 1 | cut -d' ' -f2-)"
fi
[[ -n "$iso" && -f "$iso" ]] || { echo "$tool: no ISO found; build one with sudo tools/build-iso" >&2; exit 1; }

# --- releases ------------------------------------------------------------------

# build_release N [broken]: release N of the PyreOS packages, from a copy of
# this checkout with every PyreOS package's pkgrel raised by N and a canary
# unit per reconcile scope. "broken" also makes the greeter's PAM service deny
# every session, so no login screen appears. The vendored packages are reused.
build_release() {
  local n="$1" broken="${2:-}" tree="$work/tree-$1" pkg rel
  rm -rf -- "$tree"
  mkdir -p -- "$tree/build/repo"
  rsync -a --exclude /build --exclude /.git "$repo_root/" "$tree/"
  ln -s "$repo_root/build/keys" "$tree/build/keys"
  cp -- "$repo_root"/build/repo/limine-*.pkg.tar.zst* "$tree/build/repo/"
  for pkg in "$tree"/packages/pyre-*/PKGBUILD; do
    rel="$(sed -n 's/^pkgrel=//p' "$pkg")"
    sed -i "s/^pkgrel=.*/pkgrel=$((rel + n))/" "$pkg"
  done
  cat >"$tree/src/cli/reconcile/system/900-upgrade-canary" <<'EOF'
# shellcheck shell=bash disable=SC2034
# about: test-upgrade canary (never shipped)
since=900
check() { [[ -f "$PYRE_ROOT/var/lib/pyre/upgrade-canary" ]]; }
apply() { touch "$PYRE_ROOT/var/lib/pyre/upgrade-canary"; }
EOF
  cat >"$tree/src/cli/reconcile/user/900-upgrade-canary" <<'EOF'
# shellcheck shell=bash disable=SC2034
# about: test-upgrade canary (never shipped)
since=900
check() { [[ -f "$HOME/.local/state/pyre/upgrade-canary" ]]; }
apply() { mkdir -p "$HOME/.local/state/pyre" && touch "$HOME/.local/state/pyre/upgrade-canary"; }
EOF
  if [[ "$broken" == broken ]]; then
    printf '#%%PAM-1.0\n# test-upgrade: a broken update\nauth requisite pam_deny.so\naccount requisite pam_deny.so\nsession requisite pam_deny.so\n' \
      >"$tree/system/pam.d/greetd-greeter"
  fi
  "$tree/tools/build-pkgs" >"$work/build-$n.log" 2>&1 || { tail -n 20 "$work/build-$n.log" >&2; die "building release $n failed"; }
  rm -rf -- "$served"
  mkdir -p -- "$served"
  cp -- "$tree"/build/repo/* "$served/"
  pass "release $n${broken:+ ($broken)} served at $pyre_repo"
}

serve() {
  mkdir -p -- "$served"
  if ss -ltn 2>/dev/null | grep -q '127.0.0.1:8080 '; then
    curl -fsS -o /dev/null http://127.0.0.1:8080/upgrade/repo/ 2>/dev/null ||
      die "something else listens on 127.0.0.1:8080; stop it first"
    return 0
  fi
  python3 -I -m http.server 8080 --bind 127.0.0.1 --directory "$repo_root/build" >"$work/http.log" 2>&1 &
  server_pid=$!
  sleep 1
}
trap 'stop_vm; [[ -z "$server_pid" ]] || kill "$server_pid" 2>/dev/null' EXIT

# pyre_update: pyre update as the user, unattended. The test lets the user
# run sudo without a password; the snapshots taken later include that file.
pyre_update() {
  expect sudo-nopasswd 'printf "%s\n" "'"$user"' ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/90-test-upgrade && chmod 440 /etc/sudoers.d/90-test-upgrade && echo set' '^set$'
  expect "pyre-update-$1" 'runuser -u '"$user"' -- env HOME=/home/'"$user"' pyre update --noconfirm > /var/log/test-upgrade-'"$1"'.log 2>&1; echo rc=$?; tail -n 3 /var/log/test-upgrade-'"$1"'.log' '^rc=0$'
}

# --- stages --------------------------------------------------------------------

stage_install() {
  mkdir -p -- "$work"
  install_from_iso "$iso" "pyre_repo = \"$pyre_repo\""
}

# shellcheck disable=SC2016 # probes are typed into the guest verbatim.
stage_upgrade() {
  build_release 1
  start_vm upgrade --net --boot-disk
  unlock_and_login
  expect n-1 'pacman -Q pyre-cli pyre-desktop' '^pyre-cli 0\.1\.0-1$'
  expect n-1-state 'cat /var/lib/pyre/reconcile/system' '^[1-9]$'
  pyre_update 1
  expect n-version 'pacman -Q pyre-cli pyre-desktop' '^pyre-desktop [0-9.]+-2$'
  expect system-canary 'cat /var/lib/pyre/reconcile/system; test -f /var/lib/pyre/upgrade-canary && echo canary' '^canary$'
  expect system-state 'cat /var/lib/pyre/reconcile/system' '^900$'
  expect user-canary 'cat /home/'"$user"'/.local/state/pyre/reconcile/user; test -f /home/'"$user"'/.local/state/pyre/upgrade-canary && echo canary' '^canary$'
  expect home-snapshot 'snapper -c home list --columns description' '^pyre update'
  expect snap-pac-pair 'snapper --csvout --no-headers -c root list --columns type,description | grep -cE "^(pre|post),.*pacman"' '^([2-9]|[1-9][0-9]+)$'
  expect second-run-noop 'pyre reconcile --system' 'nothing to do'
  expect doctor 'pyre doctor 2>&1 | tail -n 1' '^pyre doctor: no failures$'
  power_off
}

stage_desktop() {
  start_vm desktop --net --boot-disk
  unlock_and_login
  greeter_login
  expect login-reconcile 'u systemctl --user show pyre-reconcile.service -p Result --value' '^success$'
  shot upgraded
  power_off
}

stage_break() {
  build_release 2 broken
  start_vm break --net --boot-disk
  unlock_and_login
  pyre_update 2
  expect broken-version 'pacman -Q pyre-desktop' '^pyre-desktop [0-9.]+-3$'
  # The pre snapshot of that transaction is the one to roll back to.
  probe pre-snapshot 'snapper --csvout --no-headers -c root list --columns number,type | awk -F, '\''$2 == "pre" { n = $1 } END { print n }'\''' |
    tail -n 1 >"$work/pre-snapshot"
  [[ "$(<"$work/pre-snapshot")" =~ ^[0-9]+$ ]] || die "no pre snapshot for the broken update"
  pass "pre snapshot $(<"$work/pre-snapshot")"
  power_off

  start_vm broken --boot-disk
  unlock_and_login
  expect greeter-broken 'sleep 30; journalctl -b -o cat _UID=$(id -u greeter) | grep -c "presented first frame" || true' '^0$'
  power_off
}

stage_recover() {
  local pre
  pre="$(<"$work/pre-snapshot")"
  start_vm recover --boot-disk
  wait_for 'BdsDxe: starting' 60 || die "firmware did not start the bootloader"
  sleep 2
  # PyreOS > Snapshots, newest first: the broken update's post snapshot, then
  # its pre snapshot. Open the second one and boot its linux entry.
  send_keys down down ret
  sleep 1
  send_keys down down ret
  sleep 1
  send_keys down ret
  unlock_and_login
  expect booted-pre 'cat /proc/cmdline' "subvol=/?@snapshots/$pre/snapshot"
  greeter_login
  expect pre-version 'pacman -Q pyre-desktop' '^pyre-desktop [0-9.]+-2$'
  # pyre rollback runs limine-snapper-sync --restore, which prompts on the
  # terminal (see test-e2e's restore stage for the pacing).
  # shellcheck disable=SC2016 # typed into the guest verbatim.
  expect rollback '{ echo r; sleep 3; echo "test-upgrade rollback backup"; while sleep 3; do echo n; done; } | timeout --foreground 300 runuser -u '"$user"' -- env HOME=/home/'"$user"' pyre rollback --yes; rc=$?; sync; echo; echo rc=$rc' '^rc=0$'
  power_off
}

stage_rolled_back() {
  start_vm rolled-back --net --boot-disk
  unlock_and_login
  expect rolled-back-root 'findmnt -no SOURCE /' '\[/@\]$'
  expect rolled-back-version 'pacman -Q pyre-desktop' '^pyre-desktop [0-9.]+-2$'
  greeter_login
  shot rolled-back
  expect doctor-after 'pyre doctor 2>&1 | tail -n 1' '^pyre doctor: no failures$'
  power_off
}

serve
running=0
for stage_name in "${stages[@]}"; do
  [[ "$stage_name" == "$from" ]] && running=1
  (( running )) || { printf '== %s (skipped)\n' "$stage_name"; continue; }
  "stage_${stage_name//-/_}"
done
printf '\n%s: all stages passed\n' "$tool"
