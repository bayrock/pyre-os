#!/usr/bin/env bash
# shellcheck disable=SC2016 # the backticks are Markdown
# Write the "Every key" section of docs/KEYBINDINGS.md from the keymap itself
# (defaults/niri/binds.kdl), through the parser "pyre keys" uses. The section
# runs from its heading to the end of the file; everything above is written
# by hand. A comment line in the keymap starts a group, and the ten workspace
# keys of a family share one row.
# Usage: tools/keys-doc [--check]
#   (no option)   rewrite the section
#   --check       fail when the section differs from the keymap (tools/check)
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
doc="$repo_root/docs/KEYBINDINGS.md"
heading='## Every key'

case "${1:-}" in
  "" | --check) ;;
  -h | --help) sed -n '3,11s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; exit 0 ;;
  *) echo "keys-doc: unknown option: $1" >&2; exit 2 ;;
esac

PYRE_ROOT="" PYRE_LIB="$repo_root/src/cli"
# shellcheck source=src/cli/lib/common.sh
source "$PYRE_LIB/lib/common.sh"
# shellcheck source=src/cli/commands/keys
source "$PYRE_LIB/commands/keys"

section() {
  printf '%s\n\n%s\n' "$heading" \
    'This list is made from the keymap by `tools/keys-doc`, so it is complete. `pyre keys` (**Super + K**) shows the same list on screen, with your own keys in it.'
  KEYS_SECTIONS=1 keys_parse "$repo_root/defaults/niri/binds.kdl" | awk -F'\t' '
    function row(key, what) { printf "| %s | %s |\n", key, what }
    $1 == "#" {
      title = $2
      sub(/[.:].*/, "", title)
      printf "\n### %s\n\n| Key | Action |\n|---|---|\n", title
      next
    }
    # "Super + 1" to "Super + 0" in one row: the keymap binds ten of each.
    match($1, / \+ [0-9]$/) {
      family = substr($1, 1, RSTART - 1)
      if ($1 ~ /1$/) {
        what = $2
        sub(/ 1$/, " 1 to 10", what)
        row("`" family " + 1` … `" family " + 0`", what)
      }
      next
    }
    { row("`" $1 "`", $2) }'
}

grep -qxF -- "$heading" "$doc" 2>/dev/null || { echo "keys-doc: $doc has no \"$heading\" heading" >&2; exit 1; }
new="$(sed "/^$heading\$/,\$d" "$doc"; section)"
if [[ "${1:-}" == --check ]]; then
  diff -u --label docs/KEYBINDINGS.md --label "the keymap (run tools/keys-doc)" "$doc" <(printf '%s\n' "$new") ||
    { echo "keys-doc: docs/KEYBINDINGS.md does not match defaults/niri/binds.kdl" >&2; exit 1; }
else
  printf '%s\n' "$new" >"$doc.tmp"
  mv -f -- "$doc.tmp" "$doc"
fi
