#!/usr/bin/env bash
# shellcheck disable=SC2016 # probes are typed into the guest verbatim
# The theme system on an installed desktop (ADR 0015), headless under UEFI:
# boots a throwaway overlay of an installed test disk (default build/vm/test-e2e),
# installs the newest local pyre-base, pyre-themes, pyre-desktop and pyre-cli
# onto its existing user, checks the Limine boot menu's PyreOS look, logs in
# through the greeter, and checks that Ember reaches Noctalia and every themed
# app, that a live switch to another palette recolors open windows, and that
# pyre theme set brings Ember back. The base disk is never written.
# Usage: tools/test-theme [--base NAME]
# Evidence: build/vm/test-theme/share/desktop-*.png and limine-menu.png
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
tool=test-theme
name=test-theme
base_name=test-e2e
case "${1:-}" in
  --base) base_name="${2:?--base needs a VM name}" ;;
  -h|--help) sed -n '3,11s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; exit 0 ;;
  "") ;;
  *) echo "$tool: unknown argument: $1" >&2; exit 2 ;;
esac
# shellcheck source=tools/lib/vmtest.sh
source "$repo_root/tools/lib/vmtest.sh"

base="$repo_root/build/vm/$base_name"
[[ -f "$base/disk.qcow2" && -f "$base/OVMF_VARS.4m.fd" ]] ||
  { echo "$tool: no installed disk in $base; run tools/test-e2e first" >&2; exit 1; }
if [[ -f "$base/qemu.pid" ]] && kill -0 "$(<"$base/qemu.pid")" 2>/dev/null; then
  echo "$tool: $base_name is running; stop it first" >&2; exit 1
fi

shopt -s nullglob
rm -rf -- "$vm_dir"
mkdir -p -- "$vm_dir/share/pkgs"
for pkg in pyre-base pyre-themes pyre-desktop pyre-cli; do
  files=("$repo_root"/build/repo/"$pkg"-[0-9]*.pkg.tar.zst)
  (( ${#files[@]} )) || { echo "$tool: no $pkg in build/repo; run tools/build-pkgs" >&2; exit 1; }
  cp -- "${files[-1]}" "$vm_dir/share/pkgs/"
  [[ -f "${files[-1]}.sig" ]] && cp -- "${files[-1]}.sig" "$vm_dir/share/pkgs/"
done
qemu-img create -q -f qcow2 -b "$base/disk.qcow2" -F qcow2 "$vm_dir/disk.qcow2"
cp -- "$base/OVMF_VARS.4m.fd" "$vm_dir/"

ember_primary="$(sed -n 's/^ *"primary": "\(#[0-9a-f]*\)",$/\1/p' "$repo_root/themes/ember/palette.json" | head -n 1)"
ember_surface="$(sed -n 's/^ *"surface": "\(#[0-9a-f]*\)",$/\1/p' "$repo_root/themes/ember/palette.json" | head -n 1)"
[[ -n "$ember_primary" && -n "$ember_surface" ]] || { echo "$tool: cannot read Ember's colors" >&2; exit 1; }

# pixel_is SHOT X Y COLOR [not]: the screenshot's pixel is (or is not) COLOR.
# The open windows are foot at the left and nautilus at the right of the
# single 1280x800 output.
pixel_is() {
  local got
  got="$(magick "$share/desktop-$1.png" -format "%[hex:p{$2,$3}]" info:)"
  got="#${got:0:6}"
  if [[ "${5:-}" == not ]]; then
    [[ "${got,,}" != "${4,,}" ]] || die "$1: pixel $2,$3 is still $4"
  else
    [[ "${got,,}" == "${4,,}" ]] || die "$1: pixel $2,$3 is $got, wants $4"
  fi
  pass "$1: pixel $2,$3 ${5:+not }$4"
}

# --- 1. install the packages on the console, before anyone logs in ---------------
start_vm install-packages --net --boot-disk
unlock_and_login
expect share 'mkdir -p /mnt/share && mount -t 9p -o trans=virtio pyre-share /mnt/share && echo mounted' '^mounted$'
# Arch packages (adw-gtk-theme) come from the network, [pyre] from the testing channel.
expect install 'printf "Server = https://github.com/bayrock/pyre-os/releases/download/testing\n" > /etc/pacman.d/pyre-mirrorlist; pacman -Sy >/dev/null 2>&1; pacman -U --noconfirm /mnt/share/pkgs/*.pkg.tar.zst > /var/log/test-theme-install.log 2>&1; echo rc=$?; tail -n 2 /var/log/test-theme-install.log' '^rc=0$'
expect installed 'pacman -Q pyre-themes adw-gtk-theme | wc -l' '^2$'
# pyre-base's hook put the PyreOS block at the top of limine.conf, and the
# entries limine-entry-tool wrote are all still there.
expect limine-block 'head -n 1 /boot/limine.conf; grep -c "^interface_branding: PyreOS$" /boot/limine.conf; test -s /boot/pyre/wallpaper.jpg && echo wallpaper' '^# >>> PyreOS boot menu$'
expect limine-entries 'limine-update >/dev/null 2>&1; echo rc=$?; grep -c "^# >>> PyreOS boot menu$" /boot/limine.conf; grep -c "^ */" /boot/limine.conf' '^rc=0$'
expect limine-block-kept 'grep -c "^# >>> PyreOS boot menu$" /boot/limine.conf' '^1$'
power_off

# --- 2. the boot menu, then log in, and Ember is the theme ------------------------
start_vm session --boot-disk
# Limine waits five seconds: catch its menu. Limine's own look is black; the
# PyreOS look is the night wallpaper.
sleep 3
"$repo_root/tools/vm-ctl" --name "$name" screendump "$share/limine-menu.png" >/dev/null
lit="$(magick "$share/limine-menu.png" -crop 1280x200+0+600 +repage -format '%[fx:mean]' info:)"
awk -v m="$lit" 'BEGIN { exit !(m > 0.08) }' || die "the Limine menu shows no wallpaper (mean $lit)"
pass "limine-menu: wallpaper shown (lower band mean $lit)"
unlock_and_login
greeter_login
expect login-reconcile 'for _ in $(seq 30); do r=$(u systemctl --user show pyre-reconcile.service -p Result --value); [ -n "$r" ] && [ "$(u systemctl --user is-active pyre-reconcile.service)" != activating ] && break; sleep 1; done; echo "$r"' '^success$'
expect palette-linked 'readlink /home/'"$user"'/.config/noctalia/palettes/Ember.json' '^/usr/share/pyre/themes/ember/palette\.json$'
# The login reconcile links the palette alongside Noctalia's start; pyre theme set
# applies it either way, live.
expect theme-set 'u pyre theme set ember; echo rc=$?' '^rc=0$'
sleep 3
expect scheme 'u noctalia msg color-scheme-get' '^custom Ember$'
expect theme-current 'u pyre theme current' '^ember$'
expect theme-list 'u pyre theme list' '^\* ember'

home=/home/$user/.config
expect niri-colors 'grep -c "'"$ember_primary"'" '"$home"'/niri/noctalia.kdl' '^[1-9]'
expect niri-include 'grep -c "noctalia.kdl" '"$home"'/niri/config.kdl' '^[1-9]'
expect niri-valid 'u niri validate 2>&1 | tail -n 1' 'config is valid'
expect foot-colors 'grep -c "^background='"${ember_surface#\#}"'" '"$home"'/foot/themes/noctalia' '^1$'
expect foot-valid 'u foot --check-config && echo foot-ok' '^foot-ok$'
expect gtk4-css 'grep -ci "'"$ember_primary"'" '"$home"'/gtk-4.0/noctalia.css' '^[1-9]'
expect gtk3-css 'test -s '"$home"'/gtk-3.0/noctalia.css && echo present' '^present$'
expect btop-theme 'test -s '"$home"'/btop/themes/noctalia.theme && echo present' '^present$'
expect gtk-dark 'u gsettings get org.gnome.desktop.interface color-scheme' 'prefer-dark'
expect wallpaper 'u noctalia msg wallpaper-get' 'themes/ember/wallpapers/ember\.jpg'

# A terminal and the file manager, for the visual review.
send_keys meta_l-ret
sleep 3
expect foot-open 'u niri msg windows | grep -c "App ID: \"foot\""' '^[1-9]'
probe nautilus 'u setsid -f nautilus >/dev/null 2>&1; sleep 4' >/dev/null
shot theme-ember
pixel_is theme-ember 300 400 "$ember_surface"
pixel_is theme-ember 950 620 "$ember_surface"

# --- 3. a live switch away recolors the apps, and pyre theme set brings Ember back ---
expect switch-away 'u noctalia msg color-scheme-set builtin Noctalia >/dev/null; sleep 3; u noctalia msg color-scheme-get' '^builtin Noctalia$'
expect niri-recolored 'grep -c "'"$ember_primary"'" '"$home"'/niri/noctalia.kdl || true' '^0$'
expect foot-recolored 'grep -c "^background='"${ember_surface#\#}"'" '"$home"'/foot/themes/noctalia || true' '^0$'
expect not-current 'u pyre theme current 2>&1; true' 'no PyreOS theme'
shot theme-noctalia
# The windows already open recolor live: foot through pyre theme refresh's
# OSC sequences, nautilus through its GTK color-scheme nudge.
pixel_is theme-noctalia 300 400 "$ember_surface" not
pixel_is theme-noctalia 950 620 "$ember_surface" not
expect switch-back 'u pyre theme set ember >/dev/null; sleep 3; u noctalia msg color-scheme-get' '^custom Ember$'
expect wallpaper-again 'u noctalia msg wallpaper-get' 'themes/ember/wallpapers/ember\.jpg'
expect niri-ember-again 'grep -c "'"$ember_primary"'" '"$home"'/niri/noctalia.kdl' '^[1-9]'
shot theme-ember-again
pixel_is theme-ember-again 300 400 "$ember_surface"
pixel_is theme-ember-again 950 620 "$ember_surface"
probe evidence 'cp /var/log/test-theme-install.log /mnt/share/ 2>/dev/null; true' >/dev/null
power_off
printf '%s: PASS (screenshots in %s)\n' "$tool" "$vm_dir/share"
