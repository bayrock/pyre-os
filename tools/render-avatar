#!/usr/bin/env python3
"""Render the PyreOS avatar: the flame mark on Ember's night sky.

A square image for profile pictures (the GitHub organization, chat
servers, project thumbnails). The mark sits in the middle with room on
every side, so a circular crop keeps it whole. The colors come from the
landing page (landing/site/site.css), the mark from landing/site/pyre-e.svg.
CC BY-SA 4.0, like all PyreOS artwork.

Writes docs/images/avatar.svg (the source) and, with rsvg-convert,
avatar-1024.png and avatar-512.png. For a small transparent icon, use
landing/site/pyre-e.svg itself.

Usage: tools/render-avatar
"""
import math
import pathlib
import random
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SITE = ROOT / "landing" / "site"
OUT = ROOT / "docs" / "images"
S = 1024


def mark():
    """pyre-e.svg's path and gradient, with ids that cannot clash."""
    svg = (SITE / "pyre-e.svg").read_text()
    path = re.search(r'<path d="([^"]+)"', svg).group(1)
    stops = re.findall(r'<stop(?: offset="([\d.]+)")? stop-color="(#[0-9A-Fa-f]{6})"', svg)
    return path, [(float(o or 0), c.lower()) for o, c in stops]


def svg():
    path, stops = mark()
    rng = random.Random(58)
    # The mark is 28x38: scale it to 52% of the height, centred.
    h = S * 0.52
    k = h / 38
    w = 28 * k
    x, y = (S - w) / 2, (S - h) / 2 + S * 0.01
    stars = []
    for _ in range(46):
        sx, sy = rng.uniform(0, S), rng.uniform(0, S * 0.8)
        # keep the stars off the mark and its glow
        if math.hypot(sx - S / 2, sy - S / 2) < S * 0.36:
            continue
        r = rng.choice((1.6, 2.0, 2.4, 3.0))
        stars.append(f'<circle cx="{sx:.1f}" cy="{sy:.1f}" r="{r}" fill="#f1eadc" '
                     f'opacity="{rng.uniform(0.2, 0.6):.2f}"/>')
    grad = "\n      ".join(f'<stop offset="{o}" stop-color="{c}"/>' for o, c in stops)
    return f'''<svg xmlns="http://www.w3.org/2000/svg" width="{S}" height="{S}" viewBox="0 0 {S} {S}">
  <!-- The PyreOS avatar. Generated by tools/render-avatar; edit the tool, not
       this file. CC BY-SA 4.0, PyreOS contributors (LICENSE-ARTWORK). -->
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#130e0a"/>
      <stop offset="1" stop-color="#211912"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.5" cy="0.54" r="0.42">
      <stop offset="0" stop-color="#e9b851" stop-opacity="0.26"/>
      <stop offset="0.45" stop-color="#d9803c" stop-opacity="0.10"/>
      <stop offset="1" stop-color="#d9803c" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="flame" x1="13.5714" y1="-3.36229" x2="13.5714" y2="37.9372" gradientUnits="userSpaceOnUse">
      {grad}
    </linearGradient>
  </defs>
  <rect width="{S}" height="{S}" fill="url(#sky)"/>
  <g>
    {chr(10).join("    " + s for s in stars).strip()}
  </g>
  <rect width="{S}" height="{S}" fill="url(#glow)"/>
  <path transform="translate({x:.2f} {y:.2f}) scale({k:.4f})" fill="url(#flame)" d="{path}"/>
</svg>
'''


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    source = OUT / "avatar.svg"
    source.write_text(svg())
    for size in (1024, 512):
        png = OUT / f"avatar-{size}.png"
        subprocess.run(["rsvg-convert", "-w", str(size), "-h", str(size), "-o", str(png), str(source)], check=True)
        subprocess.run(["magick", str(png), "-strip", f"PNG24:{png}"], check=True)
    print("wrote docs/images/avatar.svg, avatar-1024.png and avatar-512.png")
    return 0


if __name__ == "__main__":
    sys.exit(main())
