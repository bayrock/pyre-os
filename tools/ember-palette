#!/usr/bin/env python3
"""Derive the Ember palette (themes/ember/palette.json) from the landing page.

The colors are the landing page's OKLCH tokens (landing/site/site.css), plus a
few roles the desktop needs on the same hue. Tune them here, not in the JSON.
Prints the palette as JSON on stdout and the contrast checks on stderr; exits
1 if a check fails. tools/check compares the output with the shipped file.

Usage: tools/ember-palette > themes/ember/palette.json
"""
import json, math, sys

def oklch(L, C, h):
    a, b = C*math.cos(math.radians(h)), C*math.sin(math.radians(h))
    l_, m_, s_ = L+0.3963377774*a+0.2158037573*b, L-0.1055613458*a-0.0638541728*b, L-0.0894841775*a-1.2914855480*b
    l, m, s = l_**3, m_**3, s_**3
    rgb = (4.0767416621*l-3.3077115913*m+0.2309699292*s,
           -1.2684380046*l+2.6097574011*m-0.3413193965*s,
           -0.0041960863*l-0.7034186147*m+1.7076147010*s)
    def enc(x):
        x = min(max(x, 0.0), 1.0)
        return 12.92*x if x <= 0.0031308 else 1.055*x**(1/2.4)-0.055
    return "#" + "".join(f"{round(enc(c)*255):02x}" for c in rgb)

def lum(hexc):
    def lin(c):
        c = int(c, 16)/255
        return c/12.92 if c <= 0.04045 else ((c+0.055)/1.055)**2.4
    r, g, b = (lin(hexc[i:i+2]) for i in (1, 3, 5))
    return 0.2126*r+0.7152*g+0.0722*b

def contrast(a, b):
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la+0.05)/(lb+0.05)

# Landing page tokens, verbatim.
coral, orange, gold, cream = "#e96d51", "#d9803c", "#e9b851", "#fdfceb"
sky     = oklch(0.17, 0.012, 58)
bg      = oklch(0.205, 0.014, 58)
far     = oklch(0.235, 0.018, 58)
near    = oklch(0.30, 0.030, 58)
muted   = oklch(0.76, 0.035, 70)
# Added for the desktop, on the same hue: a stronger outline, a hover wash,
# an error red that coral can't be mistaken for, and terminal text a touch
# softer than the cream headline colour.
outline = oklch(0.40, 0.035, 58)
hover   = oklch(0.32, 0.04, 58)
error   = oklch(0.66, 0.20, 25)
text    = oklch(0.94, 0.02, 85)
select  = oklch(0.40, 0.07, 55)

ansi_hue = {"red": 30, "green": 130, "yellow": 80, "blue": 245, "magenta": 350, "cyan": 195}
def ansi(L, C):
    return {k: oklch(L, C if k != "yellow" else C+0.02, h) for k, h in ansi_hue.items()}
normal = {"black": oklch(0.30, 0.02, 58), **ansi(0.72, 0.11), "white": oklch(0.84, 0.02, 80)}
bright = {"black": oklch(0.62, 0.03, 60), **ansi(0.80, 0.10), "white": text}
normal["yellow"], bright["yellow"] = gold, oklch(0.86, 0.12, 85)
normal["red"] = coral

dark = {
    "primary": orange, "on_primary": sky,
    "secondary": gold, "on_secondary": sky,
    "tertiary": coral, "on_tertiary": sky,
    "error": error, "on_error": sky,
    "surface": bg, "on_surface": cream, "on_surface_variant": muted,
    "surface_container": far, "outline_variant": outline,
    "shadow": "#000000", "hover": hover, "on_hover": cream,
    "terminal": {
        "background": bg, "foreground": text, "cursor": orange, "cursor_text": sky,
        "selection_bg": select, "selection_fg": cream,
        "normal": normal, "bright": bright,
    },
}

checks = [("on_surface/surface", cream, bg, 7), ("on_surface_variant/surface", muted, bg, 4.5),
          ("on_surface/container", cream, far, 7), ("on_primary/primary", sky, orange, 4.5),
          ("on_secondary/secondary", sky, gold, 4.5), ("on_tertiary/tertiary", sky, coral, 4.5),
          ("on_error/error", sky, error, 4.5), ("on_hover/hover", cream, hover, 7),
          ("primary/surface", orange, bg, 3), ("outline/surface", outline, bg, 1.5),
          ("term fg/bg", text, bg, 7), ("selection", cream, select, 4.5)]
checks += [(f"ansi {k}/bg", v, bg, 4.5) for k, v in normal.items() if k != "black"]
checks += [(f"bright {k}/bg", v, bg, 4.5) for k, v in bright.items()]
bad = 0
for name, fg, bgc, need in checks:
    c = contrast(fg, bgc); ok = c >= need; bad += not ok
    print(f"{'ok ' if ok else 'LOW'} {name:28} {c:5.2f} (>= {need})", file=sys.stderr)
json.dump({"version": 2, "dark": dark}, sys.stdout, indent=2)
print()
sys.exit(1 if bad else 0)
