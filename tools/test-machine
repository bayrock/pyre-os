#!/usr/bin/env bash
# shellcheck disable=SC2016 # probes are typed into the guest verbatim
# The development machine's setup in a VM (ROADMAP P6), headless under UEFI:
# everything about it that needs no real hardware. A second disk plays the
# Windows disk: a GPT with an ESP whose EFI/Microsoft/Boot/bootmgfw.efi is
# systemd-boot, standing in for the Windows boot manager.
#   install     the interactive installer, driven by the keyboard: every
#               prompt, with autologin and hibernation chosen, onto a disk
#               that holds an older system (an MBR table, FAT and LUKS)
#   first-boot  the answers took effect; the swapfile and the resume
#               arguments; the Windows boot entry; no keyring dialog under
#               autologin; three outputs, one of them portrait; suspend,
#               wake, and the lock that suspend sets; a prompt power-off
#   hibernate   hibernate, power off, and resume into the same session
#   chainload   boot the Windows entry from the Limine menu
# Usage: tools/test-machine [--from STAGE] [--local-packages] [ISO]
#   --local-packages   use the newest PyreOS packages in build/repo instead of
#                      the ISO's own (before an ISO rebuild)
# The default ISO is the newest build/out/pyreos-*.iso. --from resumes on the
# disks a previous run left in build/vm/test-machine/ (development only).
# Evidence: build/vm/test-machine/serial-<stage>.log and share/*.png
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
tool=test-machine
name=test-machine
# shellcheck source=tools/lib/vmtest.sh
source "$repo_root/tools/lib/vmtest.sh"
# A hostname and a timezone that are not the defaults, so the checks prove
# that the answers typed into the installer were used.
hostname=pyre-machine
timezone=Europe/Lisbon
windows="$vm_dir/windows.img"

from=install
iso=""
while (( $# )); do
  case "$1" in
    -h|--help) sed -n '3,21s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"; exit 0 ;;
    --from) from="${2:?--from needs a stage}"; shift 2 ;;
    --local-packages) local_packages=1; shift ;;
    -*) echo "$tool: unknown option: $1" >&2; exit 2 ;;
    *) iso="$1"; shift ;;
  esac
done
case "$from" in install|first-boot|hibernate|chainload) ;; *) echo "$tool: unknown stage: $from" >&2; exit 2 ;; esac
if [[ -z "$iso" ]]; then
  iso="$(find "$repo_root/build/out" -maxdepth 1 -name 'pyreos-*.iso' -printf '%T@ %p\n' 2>/dev/null |
    sort -n | tail -n 1 | cut -d' ' -f2-)"
fi
[[ -n "$iso" && -f "$iso" ]] || { echo "$tool: no ISO found; build one with sudo tools/build-iso" >&2; exit 1; }

# capture NAME: a QEMU screendump (stages without GL) as share/NAME.png.
capture() {
  local _
  for _ in $(seq 15); do
    "$repo_root/tools/vm-ctl" --name "$name" screendump "$share/$1.png" >/dev/null 2>&1 &&
      { pass "captured $1.png"; return 0; }
    sleep 1
  done
  die "no screen to capture for $1"
}

vm_state() {
  "$repo_root/tools/vm-ctl" --name "$name" status 2>/dev/null || true
}

# wait_state STATE SECONDS: until QEMU reports that run state.
wait_state() {
  local _
  for _ in $(seq "$2"); do
    [[ "$(vm_state)" == "$1" ]] && return 0
    sleep 1
  done
  return 1
}

# The stand-in Windows disk: an ESP, a reserved partition and a data
# partition, like a Windows install. systemd-boot lists the loader it finds at
# the Windows path as "Windows Boot Manager", on the screen and the serial
# console, which is how the chainload stage knows it arrived.
make_windows_disk() {
  local esp="$vm_dir/esp.img" loader=/usr/lib/systemd/boot/efi/systemd-bootx64.efi
  [[ -f "$loader" ]] || die "no $loader on this machine to stand in for the Windows boot manager"
  rm -f -- "$windows" "$esp"
  truncate -s 256M "$windows"
  printf '%s\n' 'label: gpt' \
    'start=2048, size=200M, type=U, name="EFI system partition"' \
    'size=16M, type=E3C9E316-0B5C-4DB8-817D-F92DF00215AE, name="Microsoft reserved partition"' \
    'type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name="Basic data partition"' | sfdisk -q "$windows"
  mkfs.fat -F 32 -n WINESP -C "$esp" $((200 * 1024)) >/dev/null
  mmd -i "$esp" ::/EFI ::/EFI/Microsoft ::/EFI/Microsoft/Boot ::/loader
  mcopy -i "$esp" "$loader" ::/EFI/Microsoft/Boot/bootmgfw.efi
  printf 'timeout 60\n' | mcopy -i "$esp" - ::/loader/loader.conf
  dd if="$esp" of="$windows" bs=1M seek=1 conv=notrunc status=none
  rm -f -- "$esp"
}

# The target disk as the development machine's is today: an MBR table with a
# bootable FAT partition and a LUKS volume. The installer has to name what the
# disk holds and then erase all of it, which a blank disk never asks of it.
make_used_disk() {
  local raw="$vm_dir/used.raw" part="$vm_dir/part.img"
  rm -f -- "$vm_dir/disk.qcow2" "$vm_dir/OVMF_VARS.4m.fd" "$raw" "$part"
  truncate -s 40G "$raw"
  printf '%s\n' 'label: dos' 'start=2048, size=2G, type=ef, bootable' 'type=83' | sfdisk -q "$raw"
  mkfs.fat -F 32 -n OLDBOOT -C "$part" $((2 * 1024 * 1024)) >/dev/null
  dd if="$part" of="$raw" bs=1M seek=1 conv=notrunc,sparse status=none
  rm -f -- "$part"
  truncate -s 32M "$part"
  printf 'the-old-system' | cryptsetup luksFormat --type luks2 --batch-mode --pbkdf pbkdf2 \
    --pbkdf-force-iterations 1000 --key-file - "$part"
  dd if="$part" of="$raw" bs=1M seek=2049 conv=notrunc status=none
  qemu-img convert -f raw -O qcow2 "$raw" "$vm_dir/disk.qcow2"
  rm -f -- "$raw" "$part"
}

windows_sum() {
  sha256sum "$windows" | cut -d' ' -f1
}

# prompt NAME: let the next installer prompt draw, then capture it.
step=0
prompt() {
  step=$((step + 1))
  sleep 2
  capture "$(printf 'tui-%02d-%s' "$step" "$1")"
}

stage_install() {
  rm -rf -- "$share"
  mkdir -p -- "$share"
  make_windows_disk
  windows_sum >"$vm_dir/windows.sha256"
  make_used_disk
  (( local_packages )) && stage_local_packages

  start_vm install --display none --disk2 "$windows" "$iso"
  wait_for 'archiso login:' 240 || die "the live medium did not boot"
  sleep 5
  (( local_packages )) && use_local_packages

  # The interactive installer, one prompt at a time, in tui.sh's order.
  type_keys "clear; PYRE_KERNEL_PARAMS='$kernel_params' pyre-install; echo E2E-INSTALL-EXIT=\$? > /dev/ttyS0"$'\n'
  sleep 3
  prompt disk          # first the 40 GiB disk, "holds vfat crypto_LUKS"; the other "holds vfat"
  send_keys ret
  prompt hostname      # "pyreos" is filled in: clear it
  send_keys ctrl-u
  type_keys "$hostname"$'\n'
  prompt username
  type_keys "$user"$'\n'
  sleep 2
  type_keys "$password"$'\n'
  sleep 2
  type_keys "$password"$'\n'
  sleep 2
  type_keys "$passphrase"$'\n'
  sleep 2
  type_keys "$passphrase"$'\n'
  prompt timezone      # a filter over every timezone, starting at UTC
  send_keys ctrl-u
  type_keys "${timezone#*/}"
  sleep 1
  send_keys ret
  prompt locale        # en_US.UTF-8 is filled in and is the first match
  send_keys ret
  prompt keymap        # "us" is filled in and is the first match
  send_keys ret
  prompt autologin
  type_keys y
  prompt hibernation
  type_keys y
  prompt confirm       # the summary names the disk and every answer
  type_keys 'erase'$'\n'
  wait_for '^E2E-INSTALL-EXIT=' 1800 || die "pyre-install did not finish"
  capture install-finished
  grep -qa '^E2E-INSTALL-EXIT=0' "$log" || die "pyre-install failed (see share/install-finished.png)"
  pass "pyre-install, interactive (offline)"
  power_off keyboard
  [[ "$(windows_sum)" == "$(<"$vm_dir/windows.sha256")" ]] || die "the install changed the Windows disk"
  pass "the Windows disk is byte for byte what it was"
}

stage_first_boot() {
  [[ -f "$windows" ]] || die "no Windows disk; run the install stage first"
  start_vm first-boot --boot-disk --disk2 "$windows" --outputs 3
  unlock_and_login

  # --- the installer's answers ---------------------------------------------------
  expect tui-hostname 'cat /etc/hostname' "^$hostname\$"
  expect tui-timezone 'timedatectl show -p Timezone --value' "^$timezone\$"
  expect tui-locale 'grep ^LANG= /etc/locale.conf' '^LANG=en_US.UTF-8$'
  expect tui-keymap 'grep ^KEYMAP= /etc/vconsole.conf' '^KEYMAP=us$'
  expect tui-kernel-params 'cat /proc/cmdline' 'console=ttyS0,115200 console=tty0'
  expect autologin-config 'grep -A2 "^\[initial_session\]" /etc/greetd/config.toml | tr "\n" " "; echo' "command = \"niri-session\" user = \"$user\""
  # Autologin: the session is up without anyone typing at the login screen.
  expect autologin-session 'for _ in $(seq 60); do pgrep -u '"$user"' -x niri >/dev/null && pgrep -u '"$user"' -x noctalia >/dev/null && break; sleep 1; done; pgrep -u '"$user"' -x niri >/dev/null && pgrep -u '"$user"' -x noctalia >/dev/null && echo up' '^up$'

  # --- hibernation (ADR 0017) ------------------------------------------------------
  expect swap-subvolume 'findmnt -no SOURCE /swap' '\[/@swap\]$'
  expect swapfile-nocow 'lsattr /swap/swapfile | cut -d" " -f1' 'C'
  expect swapfile-size 'echo $(( $(stat -c %s /swap/swapfile) / 1048576 )) $(awk "/^MemTotal:/ { print int((\$2 + 1023) / 1024) }" /proc/meminfo)' '^([0-9]+) \1$'
  expect swap-order 'swapon --noheadings --show=NAME,PRIO | tr -s " " | tr "\n" ";"; echo' '/dev/zram0 100;/swap/swapfile 0;|/swap/swapfile 0;/dev/zram0 100;'
  expect resume-offset 'echo "$(cat /sys/power/resume_offset) $(btrfs inspect-internal map-swapfile -r /swap/swapfile)"' '^([1-9][0-9]*) \1$'
  expect resume-device 'echo "$(cat /sys/power/resume) $(lsblk -dno MAJ:MIN /dev/mapper/root | tr -d " ")"' '^([0-9]+:[0-9]+) \1$'
  expect resume-cmdline 'grep -c "resume=/dev/mapper/root resume_offset=$(cat /sys/power/resume_offset) " /proc/cmdline' '^1$'
  expect root-snapshots-skip-swap 'btrfs subvolume list -o / | grep -c swap || true' '^0$'

  # --- the Windows boot entry (ADR 0017) -------------------------------------------
  expect windows-entry 'grep -c "^/Windows$" /boot/limine.conf' '^1$'
  expect windows-path 'echo "$(sed -n "/^\/Windows$/,/^\//s/^ *path: //p" /boot/limine.conf) uuid($(lsblk -no PARTUUID /dev/vdb1)):/EFI/Microsoft/Boot/bootmgfw.efi"' '^(uuid\([0-9a-f-]+\):/EFI/Microsoft/Boot/bootmgfw\.efi) \1$'
  expect windows-after-pyreos 'grep -n -e "^/+PyreOS$" -e "^/Windows$" /boot/limine.conf | cut -d: -f2 | tr "\n" " "; echo' '^/\+PyreOS /Windows $'
  expect no-loop-entry 'grep -c "EFI fallback" /boot/limine.conf || true' '^0$'
  expect windows-disk-unmounted 'findmnt -n /dev/vdb1 | wc -l' '^0$'
  expect pyre-doctor 'pyre doctor 2>&1 | tail -n 1' '^pyre doctor: no failures$'
  expect doctor-resume-offset 'pyre doctor --boot 2>&1 | grep -c "ok    hibernation: the resume offset is /swap/swapfile"' '^1$'
  # A transaction's snapshots rewrite the menu; the Windows entry stays, once.
  expect transaction 'pacman -U --noconfirm /var/cache/pacman/pkg/pyre-release-*.pkg.tar.zst >/dev/null && echo done' '^done$'
  expect snapshot-entries 'sleep 5; grep -c "^ *///" /boot/limine.conf' '^[1-9]'
  expect windows-entry-kept 'grep -c "^/Windows$" /boot/limine.conf' '^1$'

  # --- three outputs, one portrait (the development machine's layout) --------------
  session_helpers
  expect welcome-shown 'for _ in $(seq 60); do test -e /home/'"$user"'/.local/state/pyre/welcome/shown && break; sleep 1; done; test -e /home/'"$user"'/.local/state/pyre/welcome/shown && echo shown' '^shown$'
  expect welcome-close 'u noctalia msg panel-close pyre/welcome:welcome; echo rc=$?' '^rc=0$'
  # The autologin keyring (ADR 0018): Noctalia asks the secret service at
  # start, and without a default keyring that put a dialog on the desktop.
  expect keyring-seeded 'cat /home/'"$user"'/.local/share/keyrings/default; echo; stat -c "%U %a" /home/'"$user"'/.local/share/keyrings/Default_keyring.keyring' "^$user 600\$"
  expect no-keyring-dialog 'sleep 10; pgrep -c gcr-prompter || true' '^0$'
  expect keyring-works 'u sh -c "echo kept | secret-tool store --label=probe app e2e-probe && secret-tool lookup app e2e-probe; echo; secret-tool clear app e2e-probe"; pgrep -c gcr-prompter || true' '^kept$'
  expect outputs 'u niri msg outputs | grep -c "Current mode"' '^3$'
  # The user's own config, below the include, places the outputs: a portrait
  # one on the left, the main one, and a third above the main one.
  expect output-layout 'printf "%s\n" "output \"Virtual-1\" {" "    transform \"270\"" "    position x=0 y=0" "}" "output \"Virtual-2\" {" "    position x=800 y=800" "}" "output \"Virtual-3\" {" "    position x=800 y=0" "}" >> /home/'"$user"'/.config/niri/config.kdl && sleep 2 && u niri validate 2>&1 | tail -n 1' 'config is valid'
  expect portrait 'u niri msg outputs | grep -A12 "(Virtual-1)" | grep -E "Logical size|Transform" | tr -s " " | tr "\n" ";"; echo' 'Logical size: 800x1280;.*Transform: .*270'
  expect main-position 'u niri msg outputs | grep -A12 "(Virtual-2)" | grep "Logical position"' '800, 800'
  expect third-position 'u niri msg outputs | grep -A12 "(Virtual-3)" | grep "Logical position"' '800, 0'
  expect bars 'u niri msg layers | grep -c "noctalia-bar"' '^3$'
  expect dnd 'u noctalia msg notification-dnd-toggle; echo rc=$?' '^rc=0$'
  probe focus-portrait 'u niri msg action focus-monitor Virtual-1; sleep 1; u foot >/dev/null 2>&1 & sleep 3' >/dev/null
  shot portrait
  [[ "$(magick identify -format '%wx%h' "$share/desktop-portrait.png")" == 800x1280 ]] ||
    die "the portrait output's screenshot is not 800x1280"
  pass "the portrait output renders 800x1280"

  # --- suspend, wake, and the lock that suspend sets -----------------------------------
  # The 9p share goes first: its transport does not come back from a suspend,
  # and unmounting it afterwards would hold up the power-off below.
  expect share-unmounted 'umount /mnt/share && echo unmounted' '^unmounted$'
  serial_keys "systemctl suspend"$'\n'
  wait_state suspended 60 || die "the guest did not suspend"
  pass "suspended (QEMU run state)"
  "$repo_root/tools/vm-ctl" --name "$name" hmp system_wakeup >/dev/null
  wait_state running 30 || die "the guest did not wake"
  sleep 5
  expect suspend-exit 'journalctl -b -k -o cat | grep -c "PM: suspend exit"' '^1$'
  grep -q '"locked":true' <<<"$(noctalia_status after-suspend)" || die "the session is not locked after suspend"
  pass "locked on wake"
  type_keys "$password"$'\n'
  sleep 4
  grep -q '"locked":false' <<<"$(noctalia_status unlock)" || die "the password did not unlock after suspend"
  pass "unlock with the password"
  expect outputs-after-wake 'echo "$(u niri msg outputs | grep -c "Current mode") $(u niri msg layers | grep -c "noctalia-bar")"' '^3 3$'
  expect no-secret-in-logs "grep -rlF -e '$passphrase' -e '$password' /var/log /etc 2>/dev/null | wc -l" '^0$'
  # A session that will not stop holds a shutdown for 90 seconds (the open
  # keyring dialog did, through Noctalia).
  local began=$SECONDS
  power_off
  (( SECONDS - began < 45 )) || die "the desktop took $((SECONDS - began)) s to power off"
  pass "powered off in $((SECONDS - began)) s"
}

# Without GL (--display none): after a hibernation QEMU is a new process, and
# a GL guest's host-side resources are gone with the old one, which no real
# GPU does. niri still runs here, on a software renderer.
stage_hibernate() {
  local before after token="pyre-$RANDOM" _ deadline
  [[ -f "$windows" ]] || die "no Windows disk; run the install stage first"
  start_vm hibernate --boot-disk --disk2 "$windows" --display none
  unlock_and_login
  expect session 'for _ in $(seq 60); do pgrep -u '"$user"' -x niri >/dev/null && break; sleep 1; done; pgrep -u '"$user"' -x niri >/dev/null && echo up' '^up$'
  expect marker "echo $token > /run/pyre-hibernate && echo marked" '^marked$'
  before="$(probe before 'cat /proc/sys/kernel/random/boot_id; pgrep -u '"$user"' -x niri')"
  serial_keys "systemctl hibernate"$'\n'
  deadline=$((SECONDS + 120))
  while kill -0 "$vm_pid" 2>/dev/null; do
    (( SECONDS < deadline )) || die "the guest did not power off after hibernating"
    sleep 1
  done
  stop_vm
  pass "hibernated and powered off"

  start_vm resume --boot-disk --disk2 "$windows" --display none
  wait_for 'Please enter passphrase for disk root' 180 || die "no LUKS unlock request on the serial console"
  sleep 3
  type_keys "$passphrase"$'\n'
  # The root shell from before the hibernation answers again; a boot that did
  # not resume would stop at a login prompt instead.
  for _ in $(seq 12); do
    sleep 5
    serial_keys "echo RESUMED-\$(cat /run/pyre-hibernate)"$'\n'
    wait_for "^RESUMED-$token" 5 && break
  done
  wait_for "^RESUMED-$token" 1 || die "the system did not resume from hibernation"
  pass "resumed: the root shell and /run survived"
  after="$(probe after 'cat /proc/sys/kernel/random/boot_id; pgrep -u '"$user"' -x niri')"
  [[ -n "$before" && "$before" == "$after" ]] || die "the boot or the session changed across the hibernation"
  pass "same boot, same niri"
  expect hibernation-exit 'journalctl -b -k -o cat | grep -c "PM: hibernation: hibernation exit"' '^1$'
  power_off
}

stage_chainload() {
  [[ -f "$windows" ]] || die "no Windows disk; run the install stage first"
  start_vm chainload --boot-disk --disk2 "$windows" --display none
  wait_for 'BdsDxe: starting' 60 || die "firmware did not start the bootloader"
  sleep 2
  # The menu opens on PyreOS > linux; below it are linux-lts, Snapshots (the
  # first-boot stage made some), then Windows.
  send_keys down
  sleep 0.5
  send_keys down
  sleep 0.5
  send_keys down
  sleep 1
  capture limine-windows
  send_keys ret
  # systemd-boot, as the stand-in boot manager, draws its menu on the serial
  # console too.
  wait_for 'Windows Boot Manager.*Reboot Into Firmware Interface' 30 ||
    die "the Windows entry did not start the other disk's boot manager (see share/limine-windows.png)"
  capture windows-boot-manager
  pass "Limine chainloads the Windows boot manager on the other disk"
  stop_vm
  [[ "$(windows_sum)" == "$(<"$vm_dir/windows.sha256")" ]] || die "the Windows disk changed"
  pass "the Windows disk is still byte for byte what it was"
}

stages=(install first-boot hibernate chainload)
running=0
for name_ in "${stages[@]}"; do
  [[ "$name_" == "$from" ]] && running=1
  (( running )) || { printf '== %s (skipped)\n' "$name_"; continue; }
  "stage_${name_//-/_}"
done
printf '\n%s: all stages passed (evidence in %s)\n' "$tool" "$share"
