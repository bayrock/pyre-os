// PyreOS default keymap (docs/KEYBINDINGS.md, ADR 0021). Package-owned: do
// not edit. Rebind a key by declaring it again in ~/.config/niri/config.kdl
// after the include line; later binds override earlier ones per key.
//
// Every bind is one line with a hotkey-overlay-title: "pyre keys" (Mod+K)
// reads the key and that title from this file and from yours.

binds {
    // Launcher, menu and help
    Mod+Space     hotkey-overlay-title="Launcher: apps, and everything in the PyreOS menu" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Alt+Space hotkey-overlay-title="PyreOS menu: install, remove, update, style, setup, system" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/pyre "; }
    Mod+K         hotkey-overlay-title="Keybindings" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/keys "; }

    // Apps
    Mod+Return       hotkey-overlay-title="Terminal" { spawn "foot"; }
    Mod+Shift+Return hotkey-overlay-title="Browser" { spawn "firefox"; }
    Mod+Shift+B      hotkey-overlay-title="Browser" { spawn "firefox"; }
    Mod+Shift+F      hotkey-overlay-title="Files" { spawn "nautilus" "--new-window"; }
    Mod+Shift+N      hotkey-overlay-title="Editor" { spawn "foot" "nvim"; }
    Mod+Shift+T      hotkey-overlay-title="Activity (btop)" { spawn "foot" "btop"; }

    // Shell (Noctalia)
    Mod+S          hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Escape     hotkey-overlay-title="System menu: lock, log out, reboot, shut down" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Ctrl+L     hotkey-overlay-title="Lock the screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Ctrl+V     hotkey-overlay-title="Clipboard history" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Ctrl+E     hotkey-overlay-title="Emoji" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo "; }
    Mod+Ctrl+T     hotkey-overlay-title="Themes" { spawn "noctalia" "msg" "panel-toggle" "launcher" "/pyre Theme "; }
    Mod+Ctrl+Space hotkey-overlay-title="Wallpaper" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Ctrl+N     hotkey-overlay-title="Night light on or off" { spawn "noctalia" "msg" "nightlight-force-toggle"; }
    Mod+Shift+Space hotkey-overlay-title="Show or hide the bar" { spawn "noctalia" "msg" "bar-toggle"; }
    Mod+Comma       hotkey-overlay-title="Act on the latest notification" { spawn "noctalia" "msg" "notification-invoke-latest"; }
    Mod+Shift+Comma hotkey-overlay-title="Dismiss all notifications" { spawn "noctalia" "msg" "notification-clear-active"; }
    Mod+Ctrl+Alt+Comma hotkey-overlay-title="Do not disturb on or off" { spawn "noctalia" "msg" "notification-dnd-toggle"; }
    Alt+Tab repeat=false hotkey-overlay-title="Window switcher" { spawn "noctalia" "msg" "window-switcher" "hold"; }

    // Capture
    Print      hotkey-overlay-title="Screenshot: pick a region, window or screen" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Screenshot of the focused screen" { screenshot-screen; }
    Shift+Print hotkey-overlay-title="Screenshot of the focused window" { screenshot-window; }
    Alt+Print  hotkey-overlay-title="Start or stop a screen recording" { spawn "pyre-record"; }

    // Volume, brightness and media, with Noctalia's OSD
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume up" { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume down" { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true hotkey-overlay-title="Mute" { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true hotkey-overlay-title="Mute the microphone" { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioPlay        allow-when-locked=true hotkey-overlay-title="Play or pause" { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause       allow-when-locked=true hotkey-overlay-title="Play or pause" { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop        allow-when-locked=true hotkey-overlay-title="Stop playback" { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev        allow-when-locked=true hotkey-overlay-title="Previous track" { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext        allow-when-locked=true hotkey-overlay-title="Next track" { spawn "noctalia" "msg" "media" "next"; }
    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title="Brightness up" { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness down" { spawn "noctalia" "msg" "brightness-down"; }

    // Windows
    Mod+W repeat=false hotkey-overlay-title="Close the window" { close-window; }
    Mod+Q repeat=false hotkey-overlay-title="Close the window" { close-window; }
    Mod+F      hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+Alt+F  hotkey-overlay-title="Full width: maximize the column" { maximize-column; }
    Mod+Ctrl+F hotkey-overlay-title="Maximize the window to the screen edges" { maximize-window-to-edges; }
    Mod+T      hotkey-overlay-title="Float or tile the window" { toggle-window-floating; }
    Mod+Alt+T  hotkey-overlay-title="Switch focus between floating and tiled windows" { switch-focus-between-floating-and-tiling; }
    Mod+O repeat=false hotkey-overlay-title="Overview of every window and workspace" { toggle-overview; }

    Mod+Left  hotkey-overlay-title="Focus the column to the left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Focus the column to the right" { focus-column-right; }
    Mod+Up    hotkey-overlay-title="Focus the window above" { focus-window-up; }
    Mod+Down  hotkey-overlay-title="Focus the window below" { focus-window-down; }
    Mod+Home  hotkey-overlay-title="Focus the first column" { focus-column-first; }
    Mod+End   hotkey-overlay-title="Focus the last column" { focus-column-last; }

    Mod+Shift+Left  hotkey-overlay-title="Move the column left" { move-column-left; }
    Mod+Shift+Right hotkey-overlay-title="Move the column right" { move-column-right; }
    Mod+Shift+Up    hotkey-overlay-title="Move the window up" { move-window-up; }
    Mod+Shift+Down  hotkey-overlay-title="Move the window down" { move-window-down; }
    Mod+Shift+Home  hotkey-overlay-title="Move the column to the start" { move-column-to-first; }
    Mod+Shift+End   hotkey-overlay-title="Move the column to the end" { move-column-to-last; }

    // Columns: niri's groups. A column holds windows stacked or as tabs.
    Mod+G         hotkey-overlay-title="Show the column as tabs, or stacked" { toggle-column-tabbed-display; }
    Mod+Alt+G     hotkey-overlay-title="Move the window out of its column" { expel-window-from-column; }
    Mod+Alt+Left  hotkey-overlay-title="Move the window into the column on the left, or out" { consume-or-expel-window-left; }
    Mod+Alt+Right hotkey-overlay-title="Move the window into the column on the right, or out" { consume-or-expel-window-right; }
    Mod+Alt+Up    hotkey-overlay-title="Focus the window above in the column" { focus-window-up; }
    Mod+Alt+Down  hotkey-overlay-title="Focus the window below in the column" { focus-window-down; }
    Mod+Alt+Tab       hotkey-overlay-title="Next window in the column" { focus-window-down-or-top; }
    Mod+Alt+Shift+Tab hotkey-overlay-title="Previous window in the column" { focus-window-up-or-bottom; }
    Mod+BracketLeft  hotkey-overlay-title="Move the window into the column on the left, or out" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Move the window into the column on the right, or out" { consume-or-expel-window-right; }

    // Sizes
    Mod+R            hotkey-overlay-title="Cycle the column width presets" { switch-preset-column-width; }
    Mod+Shift+R      hotkey-overlay-title="Cycle the column width presets backwards" { switch-preset-column-width-back; }
    Mod+Ctrl+R       hotkey-overlay-title="Reset the window height" { reset-window-height; }
    Mod+Ctrl+Shift+R hotkey-overlay-title="Cycle the window height presets" { switch-preset-window-height; }
    Mod+Minus        hotkey-overlay-title="Column narrower" { set-column-width "-10%"; }
    Mod+Equal        hotkey-overlay-title="Column wider" { set-column-width "+10%"; }
    Mod+Shift+Minus  hotkey-overlay-title="Window shorter" { set-window-height "-10%"; }
    Mod+Shift+Equal  hotkey-overlay-title="Window taller" { set-window-height "+10%"; }
    Mod+Z            hotkey-overlay-title="Center the column" { center-column; }
    Mod+Shift+Z      hotkey-overlay-title="Center all visible columns" { center-visible-columns; }

    // Workspaces
    Mod+1 hotkey-overlay-title="Workspace 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="Workspace 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="Workspace 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="Workspace 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="Workspace 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="Workspace 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="Workspace 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="Workspace 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="Workspace 9" { focus-workspace 9; }
    Mod+0 hotkey-overlay-title="Workspace 10" { focus-workspace 10; }
    Mod+Shift+1 hotkey-overlay-title="Move the window to workspace 1" { move-column-to-workspace 1; }
    Mod+Shift+2 hotkey-overlay-title="Move the window to workspace 2" { move-column-to-workspace 2; }
    Mod+Shift+3 hotkey-overlay-title="Move the window to workspace 3" { move-column-to-workspace 3; }
    Mod+Shift+4 hotkey-overlay-title="Move the window to workspace 4" { move-column-to-workspace 4; }
    Mod+Shift+5 hotkey-overlay-title="Move the window to workspace 5" { move-column-to-workspace 5; }
    Mod+Shift+6 hotkey-overlay-title="Move the window to workspace 6" { move-column-to-workspace 6; }
    Mod+Shift+7 hotkey-overlay-title="Move the window to workspace 7" { move-column-to-workspace 7; }
    Mod+Shift+8 hotkey-overlay-title="Move the window to workspace 8" { move-column-to-workspace 8; }
    Mod+Shift+9 hotkey-overlay-title="Move the window to workspace 9" { move-column-to-workspace 9; }
    Mod+Shift+0 hotkey-overlay-title="Move the window to workspace 10" { move-column-to-workspace 10; }

    Mod+Tab       hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+Shift+Tab hotkey-overlay-title="Previous workspace" { focus-workspace-up; }
    Mod+Ctrl+Tab  hotkey-overlay-title="The workspace you were on before" { focus-workspace-previous; }
    Mod+Page_Down hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+Page_Up   hotkey-overlay-title="Previous workspace" { focus-workspace-up; }
    Mod+Shift+Page_Down hotkey-overlay-title="Move the window to the next workspace" { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   hotkey-overlay-title="Move the window to the previous workspace" { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down  hotkey-overlay-title="Move the whole workspace down" { move-workspace-down; }
    Mod+Ctrl+Page_Up    hotkey-overlay-title="Move the whole workspace up" { move-workspace-up; }

    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Next workspace" { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 hotkey-overlay-title="Previous workspace" { focus-workspace-up; }
    Mod+WheelScrollRight hotkey-overlay-title="Focus the column to the right" { focus-column-right; }
    Mod+WheelScrollLeft  hotkey-overlay-title="Focus the column to the left" { focus-column-left; }
    Mod+Shift+WheelScrollDown hotkey-overlay-title="Focus the column to the right" { focus-column-right; }
    Mod+Shift+WheelScrollUp   hotkey-overlay-title="Focus the column to the left" { focus-column-left; }

    // Monitors
    Ctrl+Alt+Tab       hotkey-overlay-title="Focus the next monitor" { focus-monitor-next; }
    Ctrl+Alt+Shift+Tab hotkey-overlay-title="Focus the previous monitor" { focus-monitor-previous; }
    Mod+Shift+Ctrl+Left  hotkey-overlay-title="Move the window to the monitor on the left" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right hotkey-overlay-title="Move the window to the monitor on the right" { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    hotkey-overlay-title="Move the window to the monitor above" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  hotkey-overlay-title="Move the window to the monitor below" { move-column-to-monitor-down; }
    Mod+Shift+Alt+Left  hotkey-overlay-title="Move the workspace to the monitor on the left" { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Right hotkey-overlay-title="Move the workspace to the monitor on the right" { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+Up    hotkey-overlay-title="Move the workspace to the monitor above" { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Down  hotkey-overlay-title="Move the workspace to the monitor below" { move-workspace-to-monitor-down; }

    // Session
    Mod+Shift+Escape allow-inhibiting=false hotkey-overlay-title="Let the focused app take every shortcut, or stop" { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P hotkey-overlay-title="Turn the monitors off" { power-off-monitors; }
    Ctrl+Alt+Delete hotkey-overlay-title="Quit niri, after a confirmation" { quit; }
}
